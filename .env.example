# Copy this file to .env and change the values.

# development | test | production
NODE_ENV=development

# Port the API listens on
PORT=3000

# Required. Local MongoDB, or a mongodb+srv:// address from Atlas
MONGODB_URI=mongodb://localhost:27017/my-api

# Front-end URLs allowed to call this API, separated by commas.
# Leave empty to turn CORS off.
CORS_ORIGINS=http://localhost:5173

# APP_VERSION is set by the Docker build. Do not set it here.